opt_out_usage

default_platform(:ios)

platform :ios do
  desc "Download current metadata + screenshots from App Store Connect into /tmp/asc-live"
  lane :download_state do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_API_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_PATH"]
    )

    sh("rm -rf /tmp/asc-live && mkdir -p /tmp/asc-live")

    deliver(
      api_key: api_key,
      run_precheck_before_submit: false,
      metadata_path: "/tmp/asc-live/metadata",
      screenshots_path: "/tmp/asc-live/screenshots",
      skip_binary_upload: true,
      skip_screenshots: false,
      skip_metadata: false,
      force: true
    )
  end

  desc "Fill whats_new + promotional_text on deprecated locales that ASC still requires"
  lane :fill_deprecated_locales do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_API_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_PATH"]
    )

    app = Spaceship::ConnectAPI::App.find("com.jackwallner.basketball")
    version = app.get_edit_app_store_version
    UI.user_error!("No editable version found") unless version

    # Read the copy from fastlane/metadata rather than carrying literals here.
    #
    # These were hardcoded, and they were the *baseball* app's: "Visual Statcast
    # percentile rankings and MLB Savant-style metrics ... Hitting, Pitching,
    # Fielding, and Running", left behind when this repo was forked. Running this
    # lane would have pushed MLB copy onto a live NFL listing, in eleven locales,
    # with nothing on screen to suggest it had happened. The metadata directory is
    # the single source of truth for every other locale already; there is no
    # reason for these eleven to be the exception.
    deprecated = %w[bn-BD gu-IN kn-IN ml-IN mr-IN or-IN pa-IN sl-SI ta-IN te-IN ur-PK]
    meta = File.expand_path("metadata", __dir__)

    def read_meta(meta, locale, file)
      path = File.join(meta, locale, file)
      path = File.join(meta, "en-US", file) unless File.exist?(path)
      UI.user_error!("missing metadata: #{file}") unless File.exist?(path)
      File.read(path).strip
    end

    version.get_app_store_version_localizations.each do |loc|
      next unless deprecated.include?(loc.locale)
      UI.message("Filling #{loc.locale}...")
      loc.update(attributes: {
        whatsNew: read_meta(meta, loc.locale, "release_notes.txt"),
        promotionalText: read_meta(meta, loc.locale, "promotional_text.txt")
      })
    end

    UI.success("All deprecated locales filled.")
  end

  desc "Upload screenshots and metadata to App Store Connect (fastlane 2.234+)"
  lane :upload_metadata do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_API_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_PATH"]
    )

    version = ENV["ASC_APP_VERSION"]
    UI.user_error!("Set ASC_APP_VERSION (run: eval \"$(python3 scripts/asc-ensure-draft-version.py | grep '^export ')\")") unless version && !version.empty?

    skip_shots = ENV.fetch("SKIP_SCREENSHOTS", "false") == "true"

    deliver(
      api_key: api_key,
      app_version: version,
      skip_app_version_update: true,
      force: true,
      ignore_language_directory_validation: true,
      precheck_include_in_app_purchases: false,
      version_check_wait_retry_limit: 7,
      skip_binary_upload: true,
      skip_screenshots: skip_shots,
      overwrite_screenshots: !skip_shots,
      submit_for_review: false,
      automatic_release: false,
      run_precheck_before_submit: false,
      app_review_information: {
        first_name: "Jack",
        last_name: "Wallner",
        email: "jackwallner@gmail.com",
        # The review phone lives in the gitignored review_information folder so
        # it never lands in this public repo.
        phone_number: (File.read(File.join(__dir__, "metadata/review_information/phone_number.txt")).strip rescue ""),
        demo_user: "N/A - no login or account system",
        demo_password: "",
        notes: File.read(File.join(__dir__, "metadata/review_information/notes.txt")).strip
      },
      submission_information: {
        add_id_info_uses_idfa: false
      }
    )
  end

  desc "Submit the draft version for App Store review (metadata already uploaded)"
  lane :submit_review do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_API_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_PATH"]
    )

    version = ENV["ASC_APP_VERSION"]
    UI.user_error!("Set ASC_APP_VERSION") unless version && !version.empty?
    build_number = ENV["ASC_BUILD_NUMBER"]
    UI.user_error!("Set ASC_BUILD_NUMBER") unless build_number && !build_number.empty?

    deliver(
      api_key: api_key,
      app_version: version,
      build_number: build_number,
      skip_app_version_update: true,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: true,
      force: true,
      ignore_language_directory_validation: true,
      submit_for_review: true,
      automatic_release: false,
      run_precheck_before_submit: false,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false,
        content_rights_contains_third_party_content: false
      }
    )
  end
end
